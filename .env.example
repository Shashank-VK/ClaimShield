# Copy this file to ".env" (same folder) and fill in what you use.
# .env is gitignored — keys never enter the repo. Everything is optional:
# with nothing set, the desk runs fully on built-in memory.

# OpenRouter — lets the Assistant chat answer free-form questions.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: any OpenRouter model slug (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=

# Hindsight Cloud memory instead of the built-in memory (optional).
# HINDSIGHT_API_KEY=

# Real Band room instead of the built-in local one (optional).
# BAND_AGENT_API_KEY=
# BAND_ROOM_ID=
